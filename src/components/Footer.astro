---
import { Icon } from 'astro-icon/components';
const today = new Date();
---

<footer class="fixed inset-x-0 bottom-0 z-10 px-4 py-12 text-center text-brand">
	{today.getFullYear()}.{today.getMonth() + 1}.{today.getDate()}
	<div>
		v.I
	</div>
	<div class="mt-1 flex justify-center gap-4">
		<button
			type="button"
			id="theme-toggle"
			aria-label="Toggle dark mode"
			aria-pressed="false"
			class="group cursor-pointer text-brand"
		>
			<Icon name="lucide:sun-medium" class="size-8 dark:hidden transition-transform duration-300 group-hover:scale-120 group-focus-visible:scale-120" />
			<Icon name="lucide:moon-star" class="hidden size-8 dark:block transition-transform duration-300 group-hover:scale-120 group-focus-visible:scale-120" />
		</button>
	</div>
</footer>

<script>
	// Runs in the browser. Flips the "dark" class on <html> and remembers the choice.
	const button = document.getElementById('theme-toggle');
	const root = document.documentElement;

	const syncPressed = () =>
		button?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
	syncPressed();

	button?.addEventListener('click', () => {
		const isDark = root.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		syncPressed();
	});
</script>
