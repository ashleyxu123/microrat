---
import Layout from '../layouts/PageLayout.astro';
---

<Layout
	title="About Me"
	description="a little about me :)"
	theme="theme-being"
>
	<main class="mx-auto max-w-5xl px-4 py-12">
		<div class="flex w-full items-center justify-center text-brand">
			<h1 class="font-header text-6xl">i. BEING</h1>
		</div>
	</main>
</Layout>

<style is:global>
	/* Light */
	.theme-being {
		--color-bg: #eddfc4;
		--color-brand: #651f30; /* wine */
		--color-alt: #651f30; /* blush */
	}

	/* Dark */
	.dark .theme-being {
		--color-bg: #3e2c22; /* brown */
		--color-alt: #a8697a; /* blush */
		--color-brand: #a8697a; /* blush */
	}
</style>
