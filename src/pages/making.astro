---
import Layout from '../layouts/PageLayout.astro';
---

<Layout
	title="Making"
	description="things i like to make"
	theme="theme-making"
>
	<main class="mx-auto max-w-5xl px-4 py-12">
		<div class="flex w-full items-center justify-center text-brand">
			<h1 class="font-header text-6xl">iv. MAKING</h1>
		</div>
	</main>
</Layout>

<style is:global>
	/* Light */
	.theme-making {
		--color-bg: #DCCD8B; /* pear */
		--color-brand: #7f3b25; /* sunburn */
		--color-alt: #475480; /* mozart blue */
	}

	/* Dark */
	.dark .theme-making {
		--color-bg: #475480; /* mozart blue */
		--color-brand: #DCCD8B; /* pear */
		--color-alt: #a7993c; /* green */
	}
</style>