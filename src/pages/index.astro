---
import PageLayout from '../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/background-raw.png';
import heroPhotoDark from '../assets/background-raw-dark.png';
import spiralLogoName from '../assets/logo-name.png';
import spiralLogoNameDark from '../assets/logo-name-dark.png';
import HomeLink from '../components/HomeLink.astro';
import { NAV_LINKS } from '../consts';

const logoStyle = "h-70 w-auto transition-transform duration-700 group-hover:rotate-50 group-focus-within:rotate-50"
const logoLightStyle = logoStyle + " dark:hidden"
const logoDarkStyle = logoStyle + " hidden dark:block"

---

<PageLayout showHeader={false}>
	<HomeLink class="fixed top-0 left-4 z-10" />

	<section class="relative isolate h-screen">

		<Image
			src={heroPhoto}
			alt=""
			class="absolute inset-0 -z-10 h-full w-full object-cover object-top dark:hidden"
			loading="eager"
			layout="full-width"
		/>
		<Image
			src={heroPhotoDark}
			alt=""
			class="absolute inset-0 -z-10 hidden h-full w-full object-cover object-top dark:block"
			loading="eager"
			layout="full-width"
		/>

		<nav
			aria-label="Main"
			class="group absolute top-[40%] left-[50%] -translate-x-1/2 -translate-y-1/2"
		>
			<button type="button" aria-label="Open menu" class="block cursor-pointer">
				<Image src={spiralLogoName} alt="" width={320} class={logoLightStyle} />
				<Image src={spiralLogoNameDark} alt="" width={320} class={logoDarkStyle} />
			</button>

			<ul class="invisible absolute top-full left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 pt-2 opacity-0 transition-[opacity,visibility] duration-500 ease-out group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
				{NAV_LINKS.map((link) => (
					<li><a href={link.href} class="text-xl text-brand">{link.label}</a></li>
				))}
			</ul>
		</nav>
	</section>

	<main class="mx-auto max-w-3xl px-4 py-16">
		<h1 class="text-4xl text-brand">hi im ashley</h1>
	</main>
</PageLayout>
