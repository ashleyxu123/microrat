---
import PageLayout from '../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/background.png';
import heroPhotoDark from '../assets/background-dark.png';
import heroPhotoDark2 from '../assets/background-dark-2.png';

---

<PageLayout>
	<section class="relative isolate h-screen">
		<Image
			src={heroPhoto}
			alt=""
			class="absolute inset-0 -z-10 h-full w-full object-cover object-top dark:hidden"
			loading="eager"
			layout="full-width"
		/>
		<Image
			src={heroPhotoDark2}
			alt=""
			class="absolute inset-0 -z-10 hidden h-full w-full object-cover object-top dark:block"
			loading="eager"
			layout="full-width"
		/>
	</section>

	<main class="mx-auto max-w-3xl px-4 py-16">
		<h1 class="text-4xl text-brand">hi im ashley</h1>
	</main>
</PageLayout>
