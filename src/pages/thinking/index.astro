---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="text-slate-800">
		<Header />
		<main class="mx-auto max-w-5xl px-4 py-12">
			<!-- 1 column on phones, 2 on wider screens; the newest post spans both -->
			<ul class="grid gap-8 sm:grid-cols-2">
				{
					posts.map((post, i) => (
						<li class:list={[i === 0 && 'text-center sm:col-span-2']}>
							<a href={`/blog/${post.id}/`} class="group block">
								<img
									width={720}
									height={360}
									src={post.data.heroImage}
									alt=""
									class="mb-2 w-full rounded-xl transition group-hover:shadow-xl"
								/>
								<h4
									class:list={[
										'font-bold text-slate-900 transition group-hover:text-accent',
										i === 0 ? 'text-2xl sm:text-4xl' : 'text-2xl',
									]}
								>
									{post.data.title}
								</h4>
								<p class="text-slate-500 transition group-hover:text-accent">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
