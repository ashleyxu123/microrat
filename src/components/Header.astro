---
import HeaderLink from './HeaderLink.astro';
import spiralLogo from '../assets/logo.png';
import spiralLogoDark from '../assets/logo-dark.png';
import { Image } from 'astro:assets';
import { NAV_LINKS } from '../consts';
---

<header class="px-4">
	<nav class="flex">
		<div class="fixed z-10 flex w-full gap-2">
			{NAV_LINKS.slice(0, 2).map((link) => (
				<HeaderLink href={link.href} class="flex-1 text-center">{link.label}</HeaderLink>
			))}
			<HeaderLink href="/" class="flex-1 text-center">
				<Image src={spiralLogo} alt="home" class="inline-block h-6 w-auto dark:hidden" />
				<Image src={spiralLogoDark} alt="home" class="hidden h-6 w-auto dark:inline-block" />
			</HeaderLink>
			{NAV_LINKS.slice(2).map((link) => (
				<HeaderLink href={link.href} class="flex-1 text-center">{link.label}</HeaderLink>
			))}
		</div>
	</nav>
</header>
