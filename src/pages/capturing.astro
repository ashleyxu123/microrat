---
import Layout from '../layouts/PageLayout.astro';
---

<Layout
	title="Capturing"
	description="how i capture the world around me"
	theme="theme-capturing"
>
	<main class="mx-auto max-w-5xl px-4 py-12">
		<div class="flex w-full items-center justify-center text-brand">
			<h1 class="font-header text-6xl">iii. CAPTURING</h1>
		</div>
	</main>
</Layout>

<style is:global>
	/* Light */
	.theme-capturing {
		--color-bg: #68919b; /* blue */
		--color-brand: #462736; /* oxblood */
		--color-alt: #a2a158; /* olive */
	}

	/* Dark */
	.dark .theme-capturing {
		--color-bg: #462736; /* oxblood */
		--color-brand: #68919b; /* blue */
		--color-alt: #050505; /* blush */
	}
</style>