---
import HeaderLink from './HeaderLink.astro';
import HomeLink from './HomeLink.astro';
import { NAV_LINKS } from '../consts';
---

<!-- Pinned to the top of the window, floating above page content -->
<header class="fixed inset-x-0 top-0 z-10 px-4">
	<nav class="grid grid-cols-[1fr_auto_1fr] items-center">
		<HomeLink class="justify-self-start" />

		<div class="flex gap-6">
			{NAV_LINKS.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
		</div>
	</nav>
</header>
